<launch>
  <node name="map_server" pkg="map_server" type="map_server" args="$(find quadruped_gazebo)/maps/my_room_map.yaml" />

  <node pkg="laser_scan_matcher" type="laser_scan_matcher_node" name="laser_scan_matcher_node" output="screen">
    <param name="use_imu" value="false" />
    <param name="use_odom" value="false" />
    <param name="fixed_frame" value="odom" />
    <param name="base_frame" value="base_link" />
    <param name="max_iterations" value="10" />
    <remap from="scan" to="/hokuyo_scan"/>
    <param name="publish_odom" value="true"/>
  </node>

  <node pkg="amcl" type="amcl" name="amcl">
    <param name="odom_frame_id" value="odom"/> 
    <param name="base_frame_id" value="base_link"/>
    <param name="global_frame_id" value="map"/>
    <remap from="scan" to="/hokuyo_scan"/>
  </node>

  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    <param name="base_global_planner" value="global_planner/GlobalPlanner" />
    
    <rosparam file="$(find quadruped_gazebo)/param/move_base_params.yaml" command="load" />
    <rosparam file="$(find quadruped_gazebo)/param/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find quadruped_gazebo)/param/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find quadruped_gazebo)/param/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find quadruped_gazebo)/param/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find quadruped_gazebo)/param/teb_local_planner_params.yaml" command="load" />
    <rosparam file="$(find quadruped_gazebo)/param/base_local_planner_params.yaml" command="load" />
  </node>

  </launch>
